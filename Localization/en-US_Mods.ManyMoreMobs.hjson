	BiomeSpawnRates: {
		SpawnRateMultiplier: {
			Label: Spawn Rate Multiplier
			Tooltip: Higher = enemies spawn more often in this biome (1 = vanilla).
		}

		MaxSpawnMultiplier: {
			Label: Max Spawn Multiplier
			Tooltip: Higher = allows more enemies to spawn in this biome (1 = vanilla).
		}

		Tooltip: ""
	}

	SpawnItemsConfig: {
		DisplayName: 3. Spawn Item Modifiers

		Headers: {
			MoreSpawns: Spawn Increasing Items
			FewerSpawns: Spawn Reducing Items
			Special: Special
		}

		WaterCandle: {
			Label: Water Candle
			Tooltip:
				'''
				Strength of the Water Candle effect (held or placed), including its extra deep-cave boost.
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		BattlePotion: {
			Label: Battle Potion
			Tooltip:
				'''
				Strength of the Battle Potion buff (more spawns).
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		PeaceCandle: {
			Label: Peace Candle
			Tooltip:
				'''
				Strength of the Peace Candle (fewer spawns).
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		CalmingPotion: {
			Label: Calming Potion
			Tooltip:
				'''
				Strength of the Calming Potion buff (fewer spawns).
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		Sunflower: {
			Label: Sunflower
			Tooltip:
				'''
				Strength of standing near a Sunflower (fewer spawns).
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		Invisibility: {
			Label: Invisibility
			Tooltip:
				'''
				Strength of the Invisibility effect's spawn reduction.
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		AnglerSet: {
			Label: Angler Armor Set
			Tooltip:
				'''
				Strength of the full Angler armor set's spawn reduction.
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		Fairy: {
			Label: Nearby Fairy
			Tooltip:
				'''
				Strength of the spawn reduction while near a fairy.
				This MULTIPLIES the item's own effect (1 = vanilla, 0 = off, above 1 = stronger) and stacks with your General Spawn Rate / Max Spawns, it never sets or overrides the spawn rate.
				'''
		}

		ShadowCandle: {
			Label: Shadow Candle (town NPC suppression)
			Tooltip:
				'''
				Separate from the spawn-rate items above: this only governs how strongly the Shadow Candle stops TOWN NPCs from spawning. 
				1 = full vanilla suppression, 0 = no suppression. Does not directly modify enemy spawn rate.
				'''
		}
	}

	EventsConfig: {
		DisplayName: 5. Event Length

		Headers: {
			Length: Event Length
			OldOnesArmy: Old One's Army
		}

		InvasionSizeMultiplier: {
			Label: Invasion Size Multiplier
			Tooltip:
				'''
				Multiplies how many enemies you need to defeat to finish an invasion (Goblin / Frost Legion / Pirate / Martian).
				1 = vanilla. Recommended keep higher so invasions don't end in seconds at high spawn rates.
				'''
		}

		OldOnesArmyNormalSpawnFactor: {
			Label: Normal Spawns During Old One's Army
			Tooltip:
				'''
				How much of the normal (non-event) spawn rate keeps going while Old One's Army runs, so the Etherian enemies stand out.
				0 = no normal spawns, 1 = full. Doesn't modify the event enemies.
				'''
		}

		OldOnesArmySpawnRateMultiplier: {
			Label: Old One's Army Spawn Rate
			Tooltip:
				'''
				How much faster the portals pump out Etherian enemies.
				1 = vanilla. Higher = more pouring out of the gates so the waves don't drag on higher wave lengths.
				'''
		}

		OldOnesArmyWaveLengthMultiplier: {
			Label: Old One's Army Wave Length
			Tooltip:
				'''
				Multiplies how many kills each Old One's Army wave needs.
				1 = vanilla. Higher = more kills required per wave.
				'''
		}

		MoonWaveLengthMultiplier: {
			Label: Moon Wave Length Multiplier
			Tooltip:
				'''
				Multiplies the points needed to advance each Pumpkin / Frost Moon wave.
				1 = vanilla. Higher = more time and more enemies per wave before you climb to the next.
				'''
		}
	}

	HordeCombatConfig: {
		DisplayName: 4. Horde Combat

		Headers: {
			Melee: Melee
			Ranged: Ranged
			Magic: Magic
		}

		MeleeHitsAllInSwing: {
			Label: Melee Hits All In Swing
			Tooltip:
				'''
				Lets one true-melee swing (sword / whip) hit EVERY enemy in its arc instead of just one per frame, each enemy still has its own hit cooldown.
				Affects swung weapons only, not projectiles. Defaults ON, since single-target melee really struggles against the crowds this mod can throw at you.
				'''
		}

		MeleeExtraPierce: {
			Label: Melee Extra Pierce
			Tooltip:
				'''
				Extra enemies a melee projectile (sword beams, swung-weapon projectiles) can pierce through.
				0 = vanilla.
				'''
		}

		MeleeAntiTunnel: {
			Label: Melee Anti-Tunnel
			Tooltip:
				'''
				Makes fast melee projectiles register on every enemy along their path each frame, instead of skipping over ones they zip past too quickly.
				Off = vanilla.
				'''
		}

		MeleeNoPierceFalloff: {
			Label: Melee No Pierce Falloff
			Tooltip:
				'''
				Piercing melee projectiles keep their per-hit damage right across a crowd, instead of it shrinking with every enemy pierced.
				Off = vanilla.
				'''
		}

		RangedExtraPierce: {
			Label: Ranged Extra Pierce
			Tooltip:
				'''
				Extra enemies a ranged projectile (bullets / arrows) can pierce, so guns aren't single-target in a crowd.
				0 = vanilla.
				'''
		}

		RangedAntiTunnel: {
			Label: Ranged Anti-Tunnel
			Tooltip:
				'''
				Makes fast arrows/bullets register on every enemy along their path each frame, instead of tunnelling through ones they zip past too quickly.
				Off = vanilla.
				'''
		}

		RangedNoPierceFalloff: {
			Label: Ranged No Pierce Falloff
			Tooltip:
				'''
				Piercing arrows/bullets keep their per-hit damage across a crowd, instead of it shrinking with every enemy pierced.
				Fixes "infinite pierce" arrows (e.g. Jester's Arrow) reaching the far end of a horde for ~0 damage.
				Off = vanilla.
				'''
		}

		MagicExtraPierce: {
			Label: Magic Extra Pierce
			Tooltip:
				'''
				Extra enemies a magic projectile can pierce through.
				0 = vanilla.
				'''
		}

		MagicAntiTunnel: {
			Label: Magic Anti-Tunnel
			Tooltip:
				'''
				Makes fast magic projectiles register on every enemy along their path each frame, instead of skipping over ones they zip past too quickly.
				Off = vanilla.
				'''
		}

		MagicNoPierceFalloff: {
			Label: Magic No Pierce Falloff
			Tooltip:
				'''
				Piercing magic projectiles keep their per-hit damage across a crowd, instead of it shrinking with every enemy pierced.
				Off = vanilla.
				'''
		}
	}

	NpcCapMode: {
		Tooltip: ""

		Default: {
			Label: Default
			Tooltip: ""
		}

		Expanded: {
			Label: Expanded
			Tooltip: ""
		}
	}
}
