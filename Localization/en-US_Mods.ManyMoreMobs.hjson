Configs: {
	ManyMoreMobsConfig: {
		DisplayName: 1. Many More Mobs Settings

		Headers: {
			Mode: 1. Mode - world NPC capacity
			CategoryCaps: 2. NPC slots per category
			SpawnRate: 3. Spawn rate and density
			Debug: 4. Debugging
		}

		SpawnRateMultiplier: {
			Label: Spawn Rate
			Tooltip:
				'''
				How OFTEN the game tries to spawn enemies, higher == more frequent spawns.
				Stacks on top of the usual vanilla stuff (Water Candle, Battle Potion, biome). 
				Biome-Specific Modifiers on the Biome Config page take priority over this setting.
				'''
		}

		MaxSpawnMultiplier: {
			Label: Max Active Spawns
			Tooltip:
				'''
				How MANY enemies can be active near you at once (multiplies vanilla limit).
				Works hand-in-hand with Spawn Rate, rate keeps filling up toward this max. 
				Vanilla's base is ~5, so you'll want a big value here to get near the Enemy cap. 
				'''
		}

		ReduceSpawnsWhenBossActive: {
			Label: Reduce Spawns During Boss
			Tooltip:
				'''
				While a boss is alive, throttle normal spawns so the fight isn't clogged under a pile of enemies.
				How hard it throttles is set by 'Boss-Active Spawn Factor' just below.
				'''
		}

		BossActiveSpawnFactor: {
			Label: Boss-Active Spawn Factor
			Tooltip:
				'''
				How much normal spawning carries on while a boss is up: 0 = none, 1 = full spawn rate.
				No effect if Reduce Spawns During Boss is OFF.
				'''
		}

		CapMode: {
			Label: Mode
			Tooltip:
				'''
				- Default: the vanilla 200-NPC limit, NO engine patching. Safest and most cross-mod friendly.
					All the spawn, category, and event tuning below still works, just within 200 entity limit.
				- Expanded: raises the limit to 'Max Total NPCs' (default 750) for the full horde experience.

				!! Single-player only for now. Changing this reloads the mod (a full restart is safest).
				'''
		}

		MaxNPCTotal: {
			Label: Max Total NPCs
			Tooltip:
				'''
				The total NPC budget in EXPANDED mode, shared between the four category slots below.
				The four slots should add up to this (default: 40 Town + 160 Boss + 25 Critter + 525 Enemies = 750).
				Ignored in Default mode (it's clamped to vanilla 200). Needs a reload to change.
				'''
		}

		TownNPCCap: {
			Label: Town NPC Slots
			Tooltip:
				'''
				How many town NPCs, pets and wandering merchants you can have.
				Default: acts as a hard ceiling for friendly NPCs, if there is a free slot, a low-priority enemy/critter gets despawned	to make room if the 200 is full.
				Expanded: reserved slots down in the native 0-199 zone (shared with Boss), so housing, the map and saving all behave.
				'''
		}

		BossCap: {
			Label: Boss Slots
			Tooltip:
				'''
				Bosses always spawn at full size and never get turned away, a single worm boss eats MANY of these slots (a full Destroyer is ~85 head + body segments), so keep this generous.
				Default: not a hard limit, just whether to despawn low-priority enemies/critters to ensure a full-size boss spawns.
				Expanded: reserved in the native 0-199 zone (shared with Town) so boss bars and 'is a boss alive' checks stay vanilla; the other categories are sized around it.
				'''
		}

		CritterCap: {
			Label: Critter Slots
			Tooltip:
				'''
				How many critters can be around at once. Mostly here to stop critter floods.
				A town (3+ Town NPCs with housing) suppresses enemy spawns, so the place otherwise fills up with owls and birds being way too noisy. (Personal painpoint tbh)
				Default: just a ceiling within the shared 200.
				Expanded: lives up in the expanded zone (slots 200+) alongside enemies, outside the native 0-199 array.
				'''
		}

		EnemyCap: {
			Label: Enemy Slots
			Tooltip:
				'''
				How many normal enemies can be active at once, your horde size slider, should be the biggest slice of the budget.
				Default: just a ceiling within the shared 200.
				Expanded: enemies primarily live in the expanded zone (slots 200+), while Town + Boss share the native 0-199.
					!NOTICE!
					Pushing Enemy + Critter past what the expanded zone holds (Max Total - 200);
					the overflow spills into the low slots, where it can crowd out Town NPC / Boss spawns. 
					(despawn-to-make-room can't tell low from high slots in Expanded yet)
				'''
		}

		DebugMode: {
			Label: Debug Mode
			Tooltip:
				'''
				! Leave this off for normal play.

				Auto-writes diagnostics to ManyMoreMobs-state.log on world load and before each save.
				/debugnpc commands always log anyway.
				'''
		}
	}

	BiomeSpawnConfig: {
