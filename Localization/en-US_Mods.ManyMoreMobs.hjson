		LihzahrdTemple: {
			Label: Lihzahrd Temple (post-Plantera)
			Tooltip: ""
		}

		Underworld: {
			Label: Underworld
			Tooltip: ""
		}
	}

	BiomeSpawnRates: {
		SpawnRateMultiplier: {
			Label: Spawn Rate Multiplier
			Tooltip: Higher = enemies spawn more often here. 1 = vanilla.
		}

		MaxSpawnMultiplier: {
			Label: Max Spawn Multiplier
			Tooltip: Higher = more enemies active here. 1 = vanilla.
		}

		Tooltip: ""
	}

	SpawnItemsConfig: {
		DisplayName: 3. Spawn Item Modifiers

		Headers: {
			MoreSpawns: Spawn Increasing Items
			FewerSpawns: Spawn Reducing Items
			Special: Special
		}

		WaterCandle: {
			Label: Water Candle
			Tooltip:
				'''
				Strength of the Water Candle, held or placed,
				including its deep-cave boost.
				Multiplies the item's own effect. 1 = vanilla,
				0 = off, higher = stronger. Stacks with your rates.
				'''
		}

		BattlePotion: {
			Label: Battle Potion
			Tooltip:
				'''
				Strength of the Battle Potion buff (more spawns).
				Multiplies the item's own effect. 1 = vanilla,
				0 = off, higher = stronger. Stacks with your rates.
				'''
		}

		PeaceCandle: {
			Label: Peace Candle
			Tooltip:
				'''
				Strength of the Peace Candle (fewer spawns).
				Multiplies the item's own effect. 1 = vanilla,
				0 = off, higher = stronger. Stacks with your rates.
				'''
		}

		CalmingPotion: {
			Label: Calming Potion
			Tooltip:
				'''
				Strength of the Calming Potion buff (fewer spawns).
				Multiplies the item's own effect. 1 = vanilla,
				0 = off, higher = stronger. Stacks with your rates.
				'''
		}

		Sunflower: {
			Label: Sunflower
			Tooltip:
				'''
				Strength of standing near a Sunflower (fewer spawns).
				Multiplies the item's own effect. 1 = vanilla,
				0 = off, higher = stronger. Stacks with your rates.
				'''
		}

		Invisibility: {
			Label: Invisibility
			Tooltip:
				'''
				Strength of Invisibility's spawn reduction.
				Multiplies the effect. 1 = vanilla, 0 = off,
				higher = stronger. Stacks with your rates.
				'''
		}

		AnglerSet: {
			Label: Angler Armor Set
			Tooltip:
				'''
				Strength of the full Angler set's spawn reduction.
				Multiplies the effect. 1 = vanilla, 0 = off,
				higher = stronger. Stacks with your rates.
				'''
		}

		Fairy: {
			Label: Nearby Fairy
			Tooltip:
				'''
				Strength of the spawn reduction near a fairy.
				Multiplies the effect. 1 = vanilla, 0 = off,
				higher = stronger. Stacks with your rates.
				'''
		}

		ShadowCandle: {
			Label: Shadow Candle (town NPC suppression)
			Tooltip:
				'''
				Separate from the items above: this only sets how
				strongly the Shadow Candle blocks TOWN NPC spawns.
				1 = full vanilla suppression, 0 = none.
				It does not change the enemy spawn rate.
				'''
		}
	}

	EventsConfig: {
		DisplayName: 5. Event Length

		Headers: {
			Length: Event Length
			OldOnesArmy: Old One's Army
		}

		InvasionSizeMultiplier: {
			Label: Invasion Size Multiplier
			Tooltip:
				'''
				Multiplies how many kills an invasion needs (Goblin,
				Frost Legion, Pirate, Martian). 1 = vanilla.
				Keep it higher so invasions don't end in seconds at
				a high spawn rate.
				'''
		}

		OldOnesArmyNormalSpawnFactor: {
			Label: Normal Spawns During Old One's Army
			Tooltip:
				'''
				How much normal (non-event) spawning carries on
				while Old One's Army runs, so the Etherian enemies
				stand out.
				0 = none, 1 = full. Event enemies are untouched.
				'''
		}

		OldOnesArmySpawnRateMultiplier: {
			Label: Old One's Army Spawn Rate
			Tooltip:
				'''
				How much faster the portals pump out Etherian
				enemies. 1 = vanilla.
				Higher = more pouring out, so long waves don't drag.
				'''
		}

		OldOnesArmyWaveLengthMultiplier: {
			Label: Old One's Army Wave Length
			Tooltip:
				'''
				Multiplies the kills each Old One's Army wave needs.
				1 = vanilla. Higher = longer waves.
				'''
		}

		MoonWaveLengthMultiplier: {
			Label: Moon Wave Length Multiplier
			Tooltip:
				'''
				Multiplies the points needed to advance a Pumpkin or
				Frost Moon wave.
				1 = vanilla. Higher = more enemies per wave.
				'''
		}
	}

	HordeCombatConfig: {
		DisplayName: 4. Horde Combat

		Headers: {
			Melee: Melee
			Ranged: Ranged
			Magic: Magic
			Summon: Summon
		}

		MeleeHitsAllInSwing: {
			Label: Melee Hits All In Swing
			Tooltip:
				'''
				Lets one true-melee swing (sword or whip) hit EVERY
				enemy in its arc, not just one per frame. Each enemy
				still has its own hit cooldown.
				Defaults ON: single-target melee struggles against
				the crowds this mod throws at you.
				Also keeps that cooldown ticking for swords that
				swing as a projectile, which vanilla never does.
				'''
		}

		MeleeExtraPierce: {
			Label: Melee Extra Pierce
			Tooltip:
				'''
				Extra enemies a melee projectile (sword beams, swung
				weapons) can pierce. Defaults to 5.
				The big swords have a hard cap baked in: Night's
				Edge stops at 2 enemies a swing, Excalibur and Terra
				Blade at 3. In a crowd that reads as a whiff.
				0 = vanilla.
				'''
		}

		MeleeAntiTunnel: {
			Label: Melee Anti-Tunnel
			Tooltip:
				'''
				Makes fast melee projectiles register on every enemy
				along their path each frame, instead of skipping the
				ones they zip past.
				Off = vanilla.
				'''
		}

		MeleeNoPierceFalloff: {
			Label: Melee No Pierce Falloff
			Tooltip:
				'''
				Piercing melee projectiles keep full damage across a
				crowd, instead of losing ~30% per enemy pierced.
				Fine over 5 enemies, but across a horde it decays to
				1 damage and the weapon feels broken.
				Defaults ON. Off = vanilla.
				'''
		}

		RangedExtraPierce: {
			Label: Ranged Extra Pierce
			Tooltip:
				'''
				Extra enemies a bullet or arrow can pierce, so guns
				aren't single-target in a crowd.
				0 = vanilla.
				'''
		}

		RangedAntiTunnel: {
			Label: Ranged Anti-Tunnel
			Tooltip:
				'''
				Makes fast arrows and bullets register on every
				enemy along their path each frame, instead of
				tunnelling through the ones they zip past.
				Off = vanilla.
				'''
		}

		RangedNoPierceFalloff: {
			Label: Ranged No Pierce Falloff
			Tooltip:
				'''
				Piercing arrows and bullets keep full damage across
				a crowd instead of shrinking with every enemy hit.
				Fixes infinite-pierce arrows (Jester's Arrow) that
				reach the far end of a horde for ~0 damage.
				Defaults ON. Off = vanilla.
				'''
		}

		MagicExtraPierce: {
			Label: Magic Extra Pierce
			Tooltip:
				'''
				Extra enemies a magic projectile can pierce.
				0 = vanilla.
				'''
		}

		MagicAntiTunnel: {
			Label: Magic Anti-Tunnel
			Tooltip:
				'''
				Makes fast magic projectiles register on every enemy
				along their path each frame, instead of skipping the
				ones they zip past.
				Off = vanilla.
				'''
		}

		MagicNoPierceFalloff: {
			Label: Magic No Pierce Falloff
			Tooltip:
				'''
				Piercing magic projectiles keep full damage across a
				crowd instead of shrinking with every enemy hit.
				Defaults ON. Off = vanilla.
				'''
		}

		SummonNoPierceFalloff: {
			Label: Summon No Pierce Falloff
			Tooltip:
				'''
				Whips keep full damage all along a swing instead of
				shrinking with every enemy struck.
				Whips count as summon damage, so the melee toggle
				above does not cover them.
				Defaults ON. Vanilla decay puts a Cool Whip at 0
				damage by the ninth enemy. Off = vanilla.
				'''
		}
	}

	NpcCapMode: {
		Tooltip: ""

		Default: {
			Label: Default
			Tooltip: ""
		}

		Expanded: {
			Label: Expanded
			Tooltip: ""
		}
	}
}
