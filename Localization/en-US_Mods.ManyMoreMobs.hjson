Configs: {
	ManyMoreMobsConfig: {
		DisplayName: 1. Many More Mobs Settings

		Headers: {
			Mode: 1. Mode - world NPC capacity
			CategoryCaps: 2. NPC slots per category
			SpawnRate: 3. Spawn rate and density
			Performance: 4. Performance
			DebugAndExperimental: 5. Debugging & Experimental
		}

		SpawnRateMultiplier: {
			Label: Spawn Rate
			Tooltip:
				'''
				How OFTEN the game tries to spawn enemies.
				Higher = more often.
				Stacks with Water Candle, Battle Potion, biome etc.
				Biome-Specific Modifiers override this.
				'''
		}

		MaxSpawnMultiplier: {
			Label: Max Active Spawns
			Tooltip:
				'''
				How MANY enemies can be active near you at once.
				Spawn Rate keeps filling up toward this limit.
				Vanilla's base is ~5, so go big to reach the cap.
				'''
		}

		ReduceSpawnsWhenBossActive: {
			Label: Reduce Spawns During Boss
			Tooltip:
				'''
				Throttles normal spawns while a boss is alive, so
				the fight isn't buried under a pile of enemies.
				Strength is set by the factor just below.
				'''
		}

		BossActiveSpawnFactor: {
			Label: Boss-Active Spawn Factor
			Tooltip:
				'''
				How much normal spawning carries on during a boss.
				0 = none, 1 = full rate.
				No effect if Reduce Spawns During Boss is OFF.
				'''
		}

		NormalizeRareSpawns: {
			Label: Normalize Rare Spawns
			Tooltip:
				'''
				Keeps rare lottery spawns at vanilla frequency
				instead of letting your spawn rate multiply them.
				Mainly King Slime and the Prismatic Lacewing, which
				would otherwise ambush you constantly at 200x.
				Summoning items are unaffected. Defaults ON.
				'''
		}

		LacewingSpawnBoost: {
			Label: Lacewing Spawn Boost
			Tooltip:
				'''
				Exception to the above, for the Prismatic Lacewing:
				it stays this many times more common than vanilla,
				since hunting one at full rarity is a chore.
				Vanilla rarity returns for 2 minutes after the
				Empress spawns or dies.
				No effect if Normalize Rare Spawns is OFF.
				'''
		}

		SpreadSpawnPositions: {
			Label: Spread Out Spawns (Experimental)
			Tooltip:
				'''
				Nudges each new spawn slightly sideways, so two that
				land on the same spot don't move as one.
				Skipped if the nudge would put it inside a wall.
				EXPERIMENTAL, off by default: staggered arrivals can
				read as out of place.
				'''
		}

		WidenSpawnArea: {
			Label: Widen Spawn Area (Experimental)
			Tooltip:
				'''
				Spreads spawns around a wider ring, scaled to your
				spawn rate, instead of piling them in a few spots.
				EXPERIMENTAL, off by default: a wider ring reaches
				the next biome's ground, so its enemies turn up at
				you, and everything takes longer to arrive.
				No effect at 1x spawn rate.
				'''
		}

		CapMode: {
			Label: Mode
			Tooltip:
				'''
				Default: vanilla's 200-NPC limit, no engine patching.
				Safest, and friendliest to other mods. The spawn and
				category tuning below still works within the 200.

				Expanded: raises the limit to Max Total NPCs, 750 by
				default, for the full horde.

				!! Single-player only for now.
				'''
		}

		MaxNPCTotal: {
			Label: Max Total NPCs
			Tooltip:
				'''
				The total NPC budget in Expanded mode, shared by the
				four category slots below.
				They should add up to this: 100 Town + 100 Boss +
				25 Critter + 525 Enemies = 750.
				Ignored in Default mode (clamped to vanilla 200).
				'''
		}

		TownNPCCap: {
			Label: Town NPC Slots
			Tooltip:
				'''
				How many town NPCs, pets and wandering merchants you
				can have.
				Default: a ceiling within the shared 200. A low
				priority enemy or critter is despawned to make room.
				Expanded: reserved slots in the native 0-199 zone,
				shared with Boss, so housing and saving stay vanilla.
				'''
		}

		BossCap: {
			Label: Boss Slots
			Tooltip:
				'''
				Bosses always spawn full size and are never turned
				away, and one worm eats many slots (a full Destroyer
				is ~85 head plus body). Keep this generous.
				Default: not a hard limit, just permission to
				despawn enemies so a boss fits.
				Expanded: reserved in the native 0-199 zone, shared
				with Town, so boss bars and checks stay vanilla.
				'''
		}

		CritterCap: {
			Label: Critter Slots
			Tooltip:
				'''
				How many critters can be around at once. Mostly here
				to stop critter floods: a town suppresses enemy
				spawns, so it fills up with noisy birds and owls.
				Default: a ceiling within the shared 200.
				Expanded: lives in the expanded zone, slots 200+,
				alongside enemies.
				'''
		}

		EnemyCap: {
			Label: Enemy Slots
			Tooltip:
				'''
				How many normal enemies can be active at once: your
				horde-size slider, and the biggest slice of the
				budget.
				Default: a ceiling within the shared 200.
				Expanded: enemies live in the expanded zone (200+),
				while Town and Boss share the native 0-199.

				!NOTICE! Enemy + Critter above (Max Total - 200)
				spills into the low slots and can crowd out town
				NPCs and bosses.
				'''
		}

		FastHostileProjectileScan: {
			Label: Fast Enemy Projectile Scan
			Tooltip:
				'''
				The big one for frame rate. Leave this on.

				Every enemy projectile searches the whole NPC list
				each tick, though all it can hurt is a town NPC.
				At a raised cap that was 95% of all projectile time,
				and it is what turns a screen of harpies into a
				slideshow.

				On, they stop searching past the last town NPC.
				Your own weapons still reach every enemy.
				'''
		}

		FastScanEvenWithOtherMods: {
			Label: Fast Scan Even With Other Mods
			Tooltip:
				'''
				Only matters if the load log says the fast scan was
				held back.

				Some mods let enemy projectiles hurt other enemies.
				The scan above can't tell that apart, so it switches
				itself off and names the mod in the log.

				Turn this on to use it anyway: you get the frame
				rate back, and enemies stop hurting each other.
				'''
		}

		DebugMode: {
			Label: Debug Mode
			Tooltip:
				'''
				! Leave this off for normal play.

				Writes diagnostics to ManyMoreMobs-state.log on
				world load and before each save.
				/mmm and /mmmdebug log anyway. Needed for perf.
				'''
		}

		RaiseCapBeforeOtherMods: {
			Label: Raise The Limit Before Other Mods Load
			Tooltip:
				'''
				Other mods ask Terraria how many NPC slots exist and
				size their own arrays from the answer, while they
				load. If the answer is still 200 they crash once an
				enemy lives above slot 199, which in game looks like
				enemies never spawning.
				On, the limit is raised before any other mod loads.
				Turn it off for the old behaviour.
				'''
		}

		PatchOtherModsNpcLimit: {
			Label: Fix Other Mods' NPC Limit (Fallback)
			Tooltip:
				'''
				A heavier fallback for the same problem: it rewrites
				other mods' compiled code so their reads of the NPC
				limit return the real cap.
				Only worth it if a mod still misbehaves with the
				option above on. It can't help a mod that types 200
				by hand, and it costs seconds of loading time.
				If one misbehaves either way, let me know which.
				'''
		}

		ExperimentalMultiplayerFixes: {
			Label: Experimental Multiplayer Fixes
			Tooltip:
				'''
				! Multiplayer is still NOT supported. Best-effort
				and untested by me, so treat a session as a test.

				Terraria's netcode drops packets aimed at NPCs in
				the expanded slots, which is why caught critters pop
				straight back out. This widens those checks: critter
				catching, immunity frames, debuff removal, and the
				NPCs a joining player is sent.

				Nothing happens in single-player. The host decides,
				and it applies live.
				'''
		}
	}

	BiomeSpawnConfig: {
		DisplayName: 2. Biome Spawn Modifiers

		Headers: {
			Mode: Mode
			NormalBiomes: Standard Biomes
			EvilBiomes: Corruption / Crimson / Hallow
			SpecialBiomes: Special Biomes & Structures
		}

		UseBiomeSpecificModifiers: {
			Label: Use Biome-Specific Modifiers
			Tooltip:
				'''
				OFF: the blanket Spawn Rate / Max Spawns from the
				main page apply everywhere.
				ON: each biome below uses its own multipliers
				instead. 1.0 = that biome's vanilla baseline.
				'''
		}

		Surface: {
			Label: Surface
			Tooltip: ""
